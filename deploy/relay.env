# Relay settings shipped with every deploy (VPS spec §3). No secrets. Change a value, push main,
# and deploy.yml restarts the relay with it; `GET /v1/version` serves these to the apps.
MIN_AGENT=1.0.0
MIN_MOBILE=1.0.0
LATEST_AGENT_VERSION=1.0.0
MAC_URL=https://download.shellx.pro/desktop/1.0.0/ShellX-1.0.0.dmg
WIN_URL=https://download.shellx.pro/desktop/1.0.0/ShellX-Setup-1.0.0.exe
# Minimum native desktop version (X-ShellX-Platform: macos|windows); read-only manifests come from ./downloads/desktop.
MIN_MACOS=2.0.0
MIN_WINDOWS=2.0.0
RATE_LIMITS_ENABLED=true
# v2 tickets (relay/src/config.ts): must equal the issuer relay2 runs with, exactly, no whitespace.
CMUX_RELAY_ISSUER=shellx-relay
RELAY_V2_URL=wss://relay.shellx.pro/v2/relay
