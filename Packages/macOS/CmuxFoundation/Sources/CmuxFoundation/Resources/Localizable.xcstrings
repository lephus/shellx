    "config.validation.array.max": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "must contain at most %lld item(s)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "darf höchstens %lld Element(e) enthalten"
