        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "doit contenir au plus %lld élément(s)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب ألا يتجاوز %lld عنصرًا"
