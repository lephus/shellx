    "config.settingChange.unknownPath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' isn't a ShellX setting. Run `shellx docs settings` to list them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist keine ShellX-Einstellung. Führe `shellx docs settings` aus, um alle aufzulisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'est pas un réglage ShellX. Exécutez `shellx docs settings` pour les lister."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ليس إعدادًا في ShellX. شغّل `shellx docs settings` لعرض الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' no es un ajuste de ShellX. Ejecuta `shellx docs settings` para ver la lista."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 ShellX 設定。執行 `shellx docs settings` 可列出所有設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 ShellX 设置。运行 `shellx docs settings` 可列出所有设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) ShellX 설정이 아닙니다. `shellx docs settings`를 실행해 목록을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は ShellX の設定ではありません。`shellx docs settings` を実行すると一覧を表示できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' không phải là cài đặt của ShellX. Chạy `shellx docs settings` để xem danh sách."
          }
        }
      }
    },
    "config.settingChange.notASetting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' isn't a setting. Edit that section of shellx.json directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist keine Einstellung. Bearbeite diesen Abschnitt von shellx.json direkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'est pas un réglage. Modifiez directement cette section de shellx.json."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ليس إعدادًا. عدّل هذا القسم من shellx.json مباشرةً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' no es un ajuste. Edita esa sección de shellx.json directamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是設定。請直接編輯 shellx.json 的該區段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是设置。请直接编辑 shellx.json 的该部分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 설정이 아닙니다. shellx.json의 해당 섹션을 직접 편집하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は設定ではありません。shellx.json の該当セクションを直接編集してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' không phải là một cài đặt. Hãy sửa trực tiếp phần đó trong shellx.json."
          }
        }
      }
    },
    "config.settingChange.notBoolean": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' isn't true or false, so it can't be toggled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist nicht true oder false und kann daher nicht umgeschaltet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'est ni true ni false et ne peut donc pas être basculé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ليس true أو false، لذا لا يمكن تبديله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' no es true ni false, así que no se puede alternar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 true 或 false,因此無法切換。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是 true 或 false,因此无法切换。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) true나 false가 아니므로 전환할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は true でも false でもないため、切り替えられません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' không phải true hoặc false nên không thể bật/tắt."
          }
        }
      }
    },
    "config.settingChange.emptyCycle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycling '%@' needs at least one value."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Durchschalten von '%@' ist mindestens ein Wert nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire défiler '%@' nécessite au moins une valeur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التنقّل بين قيم '%@' قيمة واحدة على الأقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para alternar entre valores de '%@' se necesita al menos un valor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "循環切換 '%@' 至少需要一個值。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循环切换 '%@' 至少需要一个值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 값을 순환하려면 값이 하나 이상 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' を順に切り替えるには、少なくとも 1 つの値が必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xoay vòng '%@' cần ít nhất một giá trị."
          }
        }
      }
    },
    "config.settingChange.unknownPreset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No setting preset named '%@'. Add it under settingPresets in ~/.config/shellx/shellx.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Einstellungsvorlage namens '%@'. Füge sie unter settingPresets in ~/.config/shellx/shellx.json hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun préréglage nommé '%@'. Ajoutez-le sous settingPresets dans ~/.config/shellx/shellx.json."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد إعداد مسبق باسم '%@'. أضفه ضمن settingPresets في ~/.config/shellx/shellx.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún preajuste llamado '%@'. Añádelo en settingPresets en ~/.config/shellx/shellx.json."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有名為 '%@' 的設定預設組。請在 ~/.config/shellx/shellx.json 的 settingPresets 下新增。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有名为 '%@' 的设置预设。请在 ~/.config/shellx/shellx.json 的 settingPresets 下添加。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'(이)라는 설정 프리셋이 없습니다. ~/.config/shellx/shellx.json의 settingPresets 아래에 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' という名前の設定プリセットはありません。~/.config/shellx/shellx.json の settingPresets に追加してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có preset cài đặt nào tên '%@'. Hãy thêm nó vào settingPresets trong ~/.config/shellx/shellx.json."
          }
        }
      }
    },
    "config.settingChange.invalidPreset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting preset '%@' must be an object of settings, for example {\"sidebar\": {\"showPorts\": false}}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsvorlage '%@' muss ein Objekt mit Einstellungen sein, zum Beispiel {\"sidebar\": {\"showPorts\": false}}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préréglage '%@' doit être un objet de réglages, par exemple {\"sidebar\": {\"showPorts\": false}}."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون الإعداد المسبق '%@' كائنًا من الإعدادات، مثل {\"sidebar\": {\"showPorts\": false}}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El preajuste '%@' debe ser un objeto de ajustes, por ejemplo {\"sidebar\": {\"showPorts\": false}}."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定預設組 '%@' 必須是設定物件,例如 {\"sidebar\": {\"showPorts\": false}}。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置预设 '%@' 必须是设置对象,例如 {\"sidebar\": {\"showPorts\": false}}。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 프리셋 '%@'은(는) 설정 객체여야 합니다. 예: {\"sidebar\": {\"showPorts\": false}}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定プリセット '%@' は設定のオブジェクトである必要があります。例: {\"sidebar\": {\"showPorts\": false}}。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset cài đặt '%@' phải là một đối tượng chứa các cài đặt, ví dụ {\"sidebar\": {\"showPorts\": false}}."
          }
        }
      }
    },
    "config.settingChange.keyContainsDot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' names a key that contains \".\", such as a workspaceGroups.byCwd path. Setting paths split on every \".\", so that key can't be changed this way. Edit it in shellx.json directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' verweist auf einen Schlüssel mit \".\", etwa einen workspaceGroups.byCwd-Pfad. Einstellungspfade werden an jedem \".\" geteilt, daher lässt sich dieser Schlüssel so nicht ändern. Bearbeite ihn direkt in shellx.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' désigne une clé qui contient \".\", par exemple un chemin workspaceGroups.byCwd. Les chemins de réglage sont découpés à chaque \".\", donc cette clé ne peut pas être modifiée ainsi. Modifiez-la directement dans shellx.json."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' يشير إلى مفتاح يحتوي على \".\"، مثل مسار workspaceGroups.byCwd. تُقسَّم مسارات الإعدادات عند كل \".\"، لذا لا يمكن تغيير هذا المفتاح بهذه الطريقة. عدّله في shellx.json مباشرةً."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' se refiere a una clave que contiene \".\", como una ruta de workspaceGroups.byCwd. Las rutas de ajustes se dividen en cada \".\", así que esa clave no se puede cambiar de esta forma. Edítala directamente en shellx.json."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 指向含有 \".\" 的鍵，例如 workspaceGroups.byCwd 路徑。設定路徑會在每個 \".\" 處分割，因此無法用這種方式變更該鍵。請直接在 shellx.json 中編輯。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 指向包含 \".\" 的键，例如 workspaceGroups.byCwd 路径。设置路径会在每个 \".\" 处拆分，因此无法用这种方式更改该键。请直接在 shellx.json 中编辑。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) \".\"이 포함된 키를 가리킵니다(예: workspaceGroups.byCwd 경로). 설정 경로는 모든 \".\"에서 나뉘므로 이 방법으로는 해당 키를 변경할 수 없습니다. shellx.json에서 직접 편집하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は \".\" を含むキー（workspaceGroups.byCwd のパスなど）を指しています。設定パスはすべての \".\" で分割されるため、この方法ではそのキーを変更できません。shellx.json で直接編集してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' là tên một khóa có chứa \".\", chẳng hạn đường dẫn workspaceGroups.byCwd. Đường dẫn cài đặt được tách theo mọi dấu \".\", nên không thể đổi khóa đó theo cách này. Hãy sửa trực tiếp trong shellx.json."
          }
        }
      }
    },
    "cli.sshPtyAttach.launchAcknowledgementTimeoutLimitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] SSH pane could not contact ShellX to start the remote session after %s attempts; reconnect to try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] Das SSH-Fenster konnte ShellX nach %s Versuchen nicht erreichen, um die Remotesitzung zu starten; verbinden Sie sich erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] Le panneau SSH n’a pas pu joindre ShellX pour démarrer la session distante après %s tentatives ; reconnectez-vous pour réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] تعذر على لوحة SSH الاتصال بـ ShellX لبدء الجلسة البعيدة بعد %s محاولات؛ أعد الاتصال للمحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] El panel SSH no pudo contactar con ShellX para iniciar la sesión remota después de %s intentos; vuelve a conectarte para intentarlo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] SSH 窗格嘗試 %s 次後仍無法聯絡 ShellX 以啟動遠端工作階段；請重新連線再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] SSH 窗格尝试 %s 次后仍无法联系 ShellX 以启动远程会话；请重新连接再试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] SSH 패널이 %s번 시도 후에도 원격 세션을 시작하기 위해 ShellX에 연결하지 못했습니다. 다시 연결해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] SSH ペインは %s 回試行しても ShellX に接続してリモートセッションを開始できませんでした。再接続してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "[ShellX] Khung SSH không thể liên lạc với shellx để bắt đầu phiên từ xa sau %s lần thử; hãy kết nối lại để thử lại."
          }
        }
      }
    },
