{
  "name": "shellx-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=dev.env --import tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "domains:update": "tsx scripts/update-disposable-domains.ts",
    "reset-password": "node --env-file=dev.env --import tsx src/scripts/reset-password.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@node-rs/argon2": "2.2.1",
    "better-sqlite3": "13.0.3",
    "hono": "^4.13.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11"
  }
}
