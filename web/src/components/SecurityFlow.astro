---
// Security diagram: phone ⇄ relay ⇄ computer. Packets carry readable text at both ends and only
// ciphertext (▓▒░) while they pass the relay. Decorative; `text` is the screen-reader equivalent.
interface Props { phone: string; relay: string; desktop: string; text: string }
const { phone, relay, desktop, text } = Astro.props;
const packets = [
  { plain: 'ls -la', delay: 0 },
  { plain: 'git status', delay: 1.6 },
  { plain: 'npm test', delay: 3.2 },
];
---
<figure class="flow">
  <figcaption class="sr-only">{text}</figcaption>
  <div class="track" aria-hidden="true">
    {packets.map((p) => (
      <span class="pkt" style={`animation-delay:${p.delay}s`}>
        <span class="chip">
          <span class="plain">{p.plain}</span>
          <span class="cipher">▓▒░▒▓░</span>
        </span>
      </span>
    ))}
  </div>
  <div class="nodes" aria-hidden="true">
    <div class="node"><span class="ico phone-ico"></span><span>{phone}</span></div>
    <div class="node relay"><span class="ico relay-ico"></span><span>{relay}</span></div>
    <div class="node"><span class="ico desk-ico"></span><span>{desktop}</span></div>
  </div>
</figure>

<style>
  .flow { position: relative; margin: 0; padding: 2.5rem 0 0; }
  .nodes { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
  .node { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; color: var(--muted);
          font-size: 0.9rem; }
  .ico { display: block; width: 4rem; height: 4rem; border-radius: 18px; background: var(--card-2);
         border: 1px solid var(--border); position: relative; box-shadow: 0 10px 30px -12px rgba(124, 58, 237, 0.7); }
  .ico::after { content: ''; position: absolute; inset: 0; margin: auto; border: 2px solid var(--purple-l); }
  .phone-ico::after { width: 1.1rem; height: 1.9rem; border-radius: 4px; }
  .desk-ico::after { width: 2.1rem; height: 1.4rem; border-radius: 3px; border-color: var(--blue-l); }
  .relay-ico::after { width: 1.9rem; height: 1.9rem; border-radius: 50%; border-color: var(--pink-l); border-style: dashed; }
  .track {
    position: absolute; z-index: 1; left: 16.66%; right: 16.66%; top: calc(2.5rem + 2rem); height: 2px;
  }
  .track::before { content: ''; position: absolute; inset: 0; opacity: 0.6;
                   background: linear-gradient(90deg, var(--purple-l), var(--pink-l), var(--blue-l)); }
  .pkt { position: absolute; inset: 0; opacity: 0; }
  .chip {
    position: absolute; left: 0; top: -2.3rem; transform: translateX(-50%);
    display: grid; padding: 0.2rem 0.55rem; border-radius: 999px; white-space: nowrap;
    font-family: var(--mono); font-size: 0.72rem; background: var(--card); border: 1px solid var(--border);
  }
  .plain, .cipher { grid-area: 1 / 1; text-align: center; }
  .plain { color: var(--ok); }
  .cipher { color: var(--pink-l); opacity: 0; }

  :global(.motion) .flow.is-in .pkt { animation: cross 4.8s linear infinite; }
  :global(.motion) .flow.is-in .plain { animation: show-plain 4.8s linear infinite; animation-delay: inherit; }
  :global(.motion) .flow.is-in .cipher { animation: show-cipher 4.8s linear infinite; animation-delay: inherit; }
  .pkt, .chip { animation-delay: inherit; }
  :global(html:not(.motion)) .pkt:first-child { opacity: 1; transform: translateX(50%); }
  :global(html:not(.motion)) .pkt:first-child .plain { opacity: 0; }
  :global(html:not(.motion)) .pkt:first-child .cipher { opacity: 1; }

  @keyframes cross { 0% { transform: translateX(0); opacity: 0; } 6%, 92% { opacity: 1; } 100% { transform: translateX(100%); opacity: 0; } }
  @keyframes show-plain { 0%, 32% { opacity: 1; } 38%, 62% { opacity: 0; } 68%, 100% { opacity: 1; } }
  @keyframes show-cipher { 0%, 32% { opacity: 0; } 38%, 62% { opacity: 1; } 68%, 100% { opacity: 0; } }

  @media (max-width: 40rem) {
    .ico { width: 3.2rem; height: 3.2rem; }
    .track { top: calc(2.5rem + 1.6rem); }
    .node { font-size: 0.8rem; }
  }
</style>
