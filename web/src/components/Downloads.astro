---
import { ui, type Lang } from '../i18n/ui';
import { appStoreUrl, desktopVersion, googlePlayUrl, macDownloadUrl, windowsDownloadUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const stores = [
  { id: 'app-store', label: t.appStore, requirement: t.appStoreRequirement, url: appStoreUrl },
  { id: 'google-play', label: t.googlePlay, requirement: t.googlePlayRequirement, url: googlePlayUrl },
];
---

<div class="downloads">
  <div class="group">
    <h3>{t.desktopHeading}</h3>
    <p class="muted">{t.version} {desktopVersion}</p>
    <a class="button" data-platform="macos" href={macDownloadUrl()}>
      <strong>{t.macos}</strong><span>{t.macosRequirement}</span>
    </a>
    <a class="button" data-platform="windows" href={windowsDownloadUrl()}>
      <strong>{t.windows}</strong><span>{t.windowsRequirement}</span>
    </a>
  </div>
  <div class="group">
    <h3>{t.mobileHeading}</h3>
    {
      stores.map((store) =>
        store.url ? (
          <a class="button" data-store={store.id} href={store.url} rel="noopener">
            <strong>{store.label}</strong>
            <span>{store.requirement}</span>
          </a>
        ) : (
          <span class="button disabled" data-store={store.id} aria-disabled="true">
            <strong>{store.label}</strong>
            <span>
              {store.requirement} · {t.comingSoon}
            </span>
          </span>
        ),
      )
    }
  </div>
</div>

<style>
  .downloads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    text-align: left;
  }
  .group {
    padding: 1.5rem; border-radius: 20px; background: rgba(21, 16, 38, 0.85); border: 1px solid var(--border);
  }
  .group h3 { margin-bottom: 0.15rem; font-size: 1.2rem; }
  .muted { color: var(--muted); margin: 0 0 1rem; font-size: 0.9rem; }
  .button {
    display: flex; flex-direction: column; padding: 0.85rem 1.1rem; margin-top: 0.75rem;
    border: 1px solid var(--border); border-radius: 14px; background: var(--bg);
    color: var(--fg); text-decoration: none;
    transition: border-color 0.2s, transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .button span { color: var(--muted); font-size: 0.88rem; }
  a.button:hover {
    border-color: var(--purple-l); transform: translateY(-2px);
    box-shadow: 0 10px 28px -12px rgba(167, 139, 250, 0.8);
  }
  .disabled { opacity: 0.6; }
</style>
