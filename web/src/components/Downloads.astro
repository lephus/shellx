---
import { ui, type Lang } from '../i18n/ui';
import { appStoreUrl, googlePlayUrl, macDownloadUrl, windowsDownloadUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

// Platform marks on a 24×24 grid. Apple, App Store and Google Play: Simple Icons (CC0,
// simpleicons.org). Windows: drawn here (four panes), Simple Icons no longer carries it.
const logos = {
  apple: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
  windows: 'M1 1h10.5v10.5H1zM12.5 1H23v10.5H12.5zM1 12.5h10.5V23H1zM12.5 12.5H23V23H12.5z',
  appStore: 'M8.8086 14.9194l6.1107-11.0368c.0837-.1513.1682-.302.2437-.4584.0685-.142.1267-.2854.1646-.4403.0803-.3259.0588-.6656-.066-.9767-.1238-.3095-.3417-.5678-.6201-.7355a1.4175 1.4175 0 0 0-.921-.1924c-.3207.043-.6135.1935-.8443.4288-.1094.1118-.1996.2361-.2832.369-.092.1463-.175.2979-.259.4492l-.3864.6979-.3865-.6979c-.0837-.1515-.1667-.303-.2587-.4492-.0837-.1329-.1739-.2572-.2835-.369-.2305-.2353-.5233-.3857-.844-.429a1.4181 1.4181 0 0 0-.921.1926c-.2784.1677-.4964.426-.6203.7355-.1246.311-.1461.6508-.066.9767.038.155.0962.2984.1648.4403.0753.1564.1598.307.2437.4584l1.248 2.2543-4.8625 8.7825H2.0295c-.1676 0-.3351-.0007-.5026.0092-.1522.009-.3004.0284-.448.0714-.3108.0906-.5822.2798-.7783.548-.195.2665-.3006.5929-.3006.9279 0 .3352.1057.6612.3006.9277.196.2683.4675.4575.7782.548.1477.043.296.0623.4481.0715.1675.01.335.009.5026.009h13.0974c.0171-.0357.059-.1294.1-.2697.415-1.4151-.6156-2.843-2.0347-2.843zM3.113 18.5418l-.7922 1.5008c-.0818.1553-.1644.31-.2384.4705-.067.1458-.124.293-.1611.452-.0785.3346-.0576.6834.0645 1.0029.1212.3175.3346.583.607.7549.2727.172.5891.2416.9013.1975.3139-.044.6005-.1986.8263-.4402.1072-.1148.1954-.2424.2772-.3787.0902-.1503.1714-.3059.2535-.4612L6 19.4636c-.0896-.149-.9473-1.4704-2.887-.9218m20.5861-3.0056a1.4707 1.4707 0 0 0-.779-.5407c-.1476-.0425-.2961-.0616-.4483-.0705-.1678-.0099-.3352-.0091-.503-.0091H18.648l-4.3891-7.817c-.6655.7005-.9632 1.485-1.0773 2.1976-.1655 1.0333.0367 2.0934.546 3.0004l5.2741 9.3933c.084.1494.167.299.2591.4435.0837.131.1739.2537.2836.364.231.2323.5238.3809.8449.4232.3192.0424.643-.0244.9217-.1899.2784-.1653.4968-.4204.621-.7257.1246-.3072.146-.6425.0658-.9641-.0381-.1529-.0962-.2945-.165-.4346-.0753-.1543-.1598-.303-.2438-.4524l-1.216-2.1662h1.596c.1677 0 .3351.0009.5029-.009.1522-.009.3007-.028.4483-.0705a1.4707 1.4707 0 0 0 .779-.5407A1.5386 1.5386 0 0 0 24 16.452a1.539 1.539 0 0 0-.3009-.9158Z',
  googlePlay: 'M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z',
};

const desktops = [
  { id: 'macos', label: t.macos, requirement: t.macosRequirement, url: macDownloadUrl(), logo: logos.apple },
  { id: 'windows', label: t.windows, requirement: t.windowsRequirement, url: windowsDownloadUrl(), logo: logos.windows },
];
const stores = [
  { id: 'app-store', label: t.appStore, requirement: t.appStoreRequirement, url: appStoreUrl, logo: logos.appStore },
  { id: 'google-play', label: t.googlePlay, requirement: t.googlePlayRequirement, url: googlePlayUrl, logo: logos.googlePlay },
];
---

<div class="downloads">
  <div class="group">
    <h3>{t.desktopHeading}</h3>
    {desktops.map((d) => (
      <a class="button" data-platform={d.id} href={d.url}>
        <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={d.logo} /></svg></span>
        <span class="txt"><strong>{d.label}</strong><span class="req">{d.requirement}</span></span>
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    ))}
  </div>
  <div class="group">
    <h3>{t.mobileHeading}</h3>
    {
      stores.map((store) =>
        store.url ? (
          <a class="button" data-store={store.id} href={store.url} rel="noopener">
            <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={store.logo} /></svg></span>
            <span class="txt"><strong>{store.label}</strong><span class="req">{store.requirement}</span></span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="button disabled" data-store={store.id} aria-disabled="true">
            <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={store.logo} /></svg></span>
            <span class="txt">
              <strong>{store.label}</strong>
              <span class="req">{store.requirement} · {t.comingSoon}</span>
            </span>
          </span>
        ),
      )
    }
  </div>
</div>

<style>
  .downloads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    text-align: left;
  }
  .group {
    padding: 1.5rem; border-radius: 20px; background: rgba(21, 16, 38, 0.85); border: 1px solid var(--border);
  }
  .group h3 { margin-bottom: 0.15rem; font-size: 1.2rem; }
  .button {
    display: flex; align-items: center; gap: 0.9rem; padding: 0.8rem 1rem; margin-top: 0.75rem;
    border: 1px solid var(--border); border-radius: 14px; background: var(--bg);
    color: var(--fg); text-decoration: none;
    transition: border-color 0.2s, transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .logo {
    flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 12px;
    color: #fff; background: linear-gradient(135deg, var(--purple), var(--pink));
  }
  .logo svg { width: 1.4rem; height: 1.4rem; fill: currentColor; }
  [data-platform='windows'] .logo { background: linear-gradient(135deg, var(--blue), var(--purple)); }
  .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .req { color: var(--muted); font-size: 0.88rem; }
  .arrow { color: var(--muted); font-size: 1.1rem; transition: transform 0.2s var(--ease), color 0.2s; }
  a.button:hover {
    border-color: var(--purple-l); transform: translateY(-2px);
    box-shadow: 0 10px 28px -12px rgba(167, 139, 250, 0.8);
  }
  a.button:hover .arrow { color: var(--purple-l); transform: translateY(2px); }
  .disabled { opacity: 0.6; }
  .disabled .logo { background: var(--card-2); color: var(--muted); border: 1px solid var(--border); }
</style>
