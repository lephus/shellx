---
import Base from '../layouts/Base.astro';
import Downloads from './Downloads.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} page="home" title={t.homeTitle} description={t.homeDescription}>
  <section class="hero">
    <h1>{t.tagline}</h1>
    <p>{t.intro}</p>
    <p class="e2e">{t.e2e}</p>
  </section>
  <Downloads lang={lang} />
  <section>
    <h2>{t.stepsHeading}</h2>
    <ol>
      <li>{t.step1}</li>
      <li>{t.step2}</li>
      <li>{t.step3}</li>
    </ol>
  </section>
</Base>

<style>
  .hero h1 {
    font-size: 2rem;
    line-height: 1.25;
    margin-top: 2rem;
  }
  .e2e {
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--accent);
    background: var(--card);
  }
</style>
