---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import TermBlock from '../components/TermBlock.astro';
import { ui } from '../i18n/ui';

// nginx serves dist/404.html with status 404 for unknown paths (deploy/web/nginx.conf).
const en = ui.en;
---

<Base lang="en" page={null} title={`${en.notFoundTitle} — ShellX`} description={en.notFoundBody}>
  <div class="wrap nf">
    <Terminal title="shellx@pro — 404">
      <TermBlock command="open …">
        <p class="err" aria-hidden="true">zsh: command not found</p>
        <h1>{en.notFoundTitle}</h1>
        <p>{en.notFoundBody} <a href="/">{en.backHome}</a></p>
      </TermBlock>
    </Terminal>
  </div>
</Base>
<style>
  .nf { max-width: 52rem; padding-top: 3rem; font-family: var(--mono); }
  .err { color: #f87171; margin: 0.25rem 0 0; }
</style>
