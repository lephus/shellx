---
import { otherLang, pathFor, ui, type Lang, type Page } from '../i18n/ui';
import { supportEmail } from '../lib/site';

interface Props {
  lang: Lang;
  /** null for pages without a translated counterpart (404). */
  page: Page | null;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const switchHref = pathFor(other, page ?? 'home');
const site = Astro.site ?? new URL('https://shellx.pro');
const year = new Date().getFullYear();
const ogImage = new URL(lang === 'en' ? '/og/og-en.png' : '/og/og-vi.png', site).href;
const pageUrl = page ? new URL(pathFor(lang, page), site).href : site.href;
const home = pathFor(lang, 'home');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {page && <link rel="canonical" href={new URL(pathFor(lang, page), site).href} />}
    {page && <link rel="alternate" hreflang="vi" href={new URL(pathFor('vi', page), site).href} />}
    {page && <link rel="alternate" hreflang="en" href={new URL(pathFor('en', page), site).href} />}
    {page && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('vi', page), site).href} />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/JetBrainsMono-Regular.woff2" crossorigin />
    <meta name="theme-color" content="#0b1120" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShellX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={home}><span aria-hidden="true">~/</span>shellx</a>
        <nav class="top-nav">
          <a href={`${home}#features`}>{t.featuresHeading}</a>
          <a href={`${home}#security`}>{t.securityHeading}</a>
          <a href={`${home}#faq`}>FAQ</a>
        </nav>
        <a class="cta" href={`${home}#download`}><span aria-hidden="true">↓ </span>{t.download}</a>
        <a class="lang-switch" href={switchHref} hreflang={other} lang={other}
          ><span aria-hidden="true">--lang=</span>{other}</a>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap bottom">
      <nav>
        <a class="dl" href={`${pathFor(lang, 'home')}#download`}>{t.download}</a>
        <a href={pathFor(lang, 'privacy')}>{t.privacy}</a>
        <a href={pathFor(lang, 'terms')}>{t.terms}</a>
        <a href={`mailto:${supportEmail}`}>{t.contact}: {supportEmail}</a>
      </nav>
      <p>© {year} ShellX</p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2');
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('/fonts/JetBrainsMono-Bold.woff2') format('woff2');
    font-weight: 700; font-style: normal; font-display: swap;
  }
  :root {
    color-scheme: dark;
    --bg: #0b1120; --fg: #e2e8f0; --muted: #94a3b8;
    --accent: #22d3ee; --ok: #4ade80; --card: #0f172a; --border: #1e293b;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font-family: var(--mono); line-height: 1.7; font-size: 0.95rem;
  }
  a { color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .wrap { max-width: 52rem; margin: 0 auto; padding: 0 1rem; }
  .top {
    position: sticky; top: 0; z-index: 10;
    background: rgba(11, 17, 32, 0.85);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .top-inner {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 1.25rem;
    padding-top: 0.7rem; padding-bottom: 0.7rem;
  }
  .top-nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin-right: auto; }
  .top-nav a { color: var(--muted); text-decoration: none; }
  .top-nav a:hover { color: var(--fg); }
  .cta {
    border: 1px solid var(--accent); border-radius: 0.4rem;
    padding: 0.15rem 0.7rem; font-weight: 700; text-decoration: none;
  }
  .cta:hover { background: rgba(34, 211, 238, 0.1); }
  [id] { scroll-margin-top: 5rem; }
  .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  .brand span, .lang-switch span { color: var(--muted); }
  .lang-switch { text-decoration: none; }
  .bottom { margin-top: 3rem; padding-top: 1rem; padding-bottom: 2rem;
            border-top: 1px solid var(--border); color: var(--muted); font-size: 0.85rem; }
  .bottom nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .bottom .dl { font-weight: 700; }
  .bottom .dl::before { content: '↓ '; }
  code { font-family: var(--mono); font-size: 0.9em; }
</style>
