---
import { otherLang, pathFor, ui, type Lang, type Page } from '../i18n/ui';
import { supportEmail } from '../lib/site';

interface Props {
  lang: Lang;
  /** null for pages without a translated counterpart (404). */
  page: Page | null;
  title: string;
  description: string;
  /** The page's path in each language, for pages outside `Page` (guides). Wins over `page`. */
  paths?: Record<Lang, string>;
  /** og:type: `article` for guides. */
  ogType?: 'website' | 'article';
  /** Header with the brand only: no marketing nav, language switch or download CTA (share viewer). */
  minimalHeader?: boolean;
}

const { lang, page, title, description, paths: given, ogType = 'website', minimalHeader = false } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const paths: Record<Lang, string> | null =
  given ?? (page ? { vi: pathFor('vi', page), en: pathFor('en', page) } : null);
const switchHref = paths ? paths[other] : pathFor(other, 'home');
const site = Astro.site ?? new URL('https://shellx.pro');
const year = new Date().getFullYear();
const ogImage = new URL(lang === 'en' ? '/og/og-en.png' : '/og/og-vi.png', site).href;
const pageUrl = paths ? new URL(paths[lang], site).href : site.href;
const home = pathFor(lang, 'home');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {paths && <link rel="canonical" href={pageUrl} />}
    {paths && <link rel="alternate" hreflang="vi" href={new URL(paths.vi, site).href} />}
    {paths && <link rel="alternate" hreflang="en" href={new URL(paths.en, site).href} />}
    {paths && <link rel="alternate" hreflang="x-default" href={new URL(paths.vi, site).href} />}
    <meta name="robots" content={paths ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex'} />
    <meta name="author" content="ShellPro Team" />
    <meta name="application-name" content="ShellX" />
    <meta name="apple-mobile-web-app-title" content="ShellX" />
    <meta name="color-scheme" content="dark" />
    <link rel="alternate" type="text/plain" title="ShellX for LLMs" href="/llms.txt" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SpaceGrotesk-Latin.woff2" crossorigin />
    {lang === 'vi' && <link rel="preload" as="font" type="font/woff2" href="/fonts/SpaceGrotesk-Vietnamese.woff2" crossorigin />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/JetBrainsMono-Regular.woff2" crossorigin />
    <meta name="theme-color" content="#0b0716" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ShellX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <script is:inline>
      // Scroll-in reveals only hide content once we know JS runs and motion is welcome.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href={home}><img class="brand-mark" src="/favicon.svg" alt="" width="28" height="28" />shellx</a>
        {!minimalHeader && (
          <nav class="top-nav" aria-label={t.mainNav}>
            <a href={`${home}#features`}>{t.featuresHeading}</a>
            <a href={`${home}#security`}>{t.securityHeading}</a>
            <a href={pathFor(lang, 'guides')}>{t.guidesNav}</a>
            <a href={`${home}#faq`}>FAQ</a>
            <a class="nav-wide" href={`${home}#contact`}>{t.contactHeading}</a>
          </nav>
        )}
        {!minimalHeader && <a class="lang-switch" href={switchHref} hreflang={other} lang={other}>{other.toUpperCase()}</a>}
        {!minimalHeader && <a class="btn btn-primary btn-sm" href={`${home}#download`}>{t.download}</a>}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <div class="wrap bottom-inner">
        <div>
          <a class="brand" href={home}><img class="brand-mark" src="/favicon.svg" alt="" width="28" height="28" />shellx</a>
          <p class="muted">{t.footerTagline}</p>
        </div>
        <nav aria-label="Footer">
          <a class="dl" href={`${home}#download`}>{t.download}</a>
          <a href={pathFor(lang, 'guides')}>{t.guidesNav}</a>
          <a href={pathFor(lang, 'privacy')}>{t.privacy}</a>
          <a href={pathFor(lang, 'terms')}>{t.terms}</a>
          <a href={`mailto:${supportEmail}`}>{t.contact}: {supportEmail}</a>
        </nav>
      </div>
      <p class="wrap copy">© {year} ShellX</p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Space Grotesk';
    src: url('/fonts/SpaceGrotesk-Latin.woff2') format('woff2');
    font-weight: 300 700; font-style: normal; font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
      U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Space Grotesk';
    src: url('/fonts/SpaceGrotesk-Vietnamese.woff2') format('woff2');
    font-weight: 300 700; font-style: normal; font-display: swap;
    unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0,
      U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2');
    font-weight: 400; font-style: normal; font-display: swap;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('/fonts/JetBrainsMono-Bold.woff2') format('woff2');
    font-weight: 700; font-style: normal; font-display: swap;
  }
  :root {
    color-scheme: dark;
    --bg: #0b0716; --card: #151026; --card-2: #1c1533; --border: #2a2145;
    --fg: #ece9f6; --muted: #a69fc0;
    --purple: #7c3aed; --purple-l: #a78bfa; --blue: #3b82f6; --blue-l: #60a5fa;
    --pink: #ec4899; --pink-l: #f472b6; --ok: #4ade80;
    --accent: var(--purple-l);
    --grad: linear-gradient(100deg, var(--blue-l), var(--purple-l) 45%, var(--pink-l));
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --display: 'Space Grotesk', var(--sans);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font-family: var(--sans); line-height: 1.65; font-size: 1rem;
    -webkit-font-smoothing: antialiased; overflow-x: hidden;
  }
  h1, h2, h3 { font-family: var(--display); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 0.6rem; text-wrap: balance; }
  a { color: var(--purple-l); }
  :focus-visible { outline: 2px solid var(--pink-l); outline-offset: 3px; border-radius: 4px; }
  code { font-family: var(--mono); font-size: 0.9em; }
  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.25rem; }
  .muted { color: var(--muted); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .grad-text { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  [id] { scroll-margin-top: 5rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.8rem 1.4rem; border-radius: 999px; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s;
  }
  .btn-sm { padding: 0.45rem 1rem; font-size: 0.9rem; }
  .btn-primary {
    color: #fff; background: linear-gradient(100deg, var(--purple), var(--pink));
    box-shadow: 0 6px 24px -6px rgba(236, 72, 153, 0.55);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 32px -6px rgba(236, 72, 153, 0.75); }
  .btn-ghost { color: var(--fg); border-color: var(--border); background: rgba(255, 255, 255, 0.03); }
  .btn-ghost:hover { border-color: var(--purple-l); background: rgba(167, 139, 250, 0.08); }

  .top {
    position: sticky; top: 0; z-index: 20;
    background: rgba(11, 7, 22, 0.72);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(42, 33, 69, 0.7);
  }
  .top-inner { display: flex; align-items: center; gap: 0.5rem 1.5rem; min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--mono); font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  .brand-mark { display: block; width: 1.75rem; height: 1.75rem; }
  .top-nav { display: flex; gap: 1.5rem; margin-right: auto; margin-left: 1rem; }
  .top-nav a, .lang-switch { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  .top-nav a:hover, .lang-switch:hover { color: var(--fg); }
  .lang-switch { font-family: var(--mono); font-size: 0.85rem; padding: 0.5rem; }
  /* A fifth menu item would wrap the header on tablets; the footer still links the address. */
  @media (max-width: 48rem) { .top-nav .nav-wide { display: none; } }
  @media (max-width: 40rem) {
    .top-nav { display: none; }
    .lang-switch { margin-left: auto; }
  }

  .bottom { margin-top: 4rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; }
  .bottom-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; padding-top: 2.5rem; }
  .bottom-inner p { margin: 0.4rem 0 0; }
  .bottom nav { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: flex-start; }
  .bottom nav a { color: var(--muted); text-decoration: none; padding: 0.25rem 0; }
  .bottom nav a:hover { color: var(--fg); }
  .bottom .dl { color: var(--purple-l); font-weight: 600; }
  .copy { padding-top: 1.5rem; padding-bottom: 2.5rem; margin: 0; font-size: 0.85rem; }

  /* Scroll-in reveal: [data-reveal] fades up when it enters the viewport (see Home.astro script). */
  .motion [data-reveal] {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    transition-delay: calc(var(--i, 0) * 110ms);
  }
  .motion [data-reveal].is-in { opacity: 1; transform: none; }
</style>
