---
// Layout of src/pages/guides/*.md and src/pages/en/guides/*.md: breadcrumb, article, download CTA,
// related guides, TechArticle + BreadcrumbList JSON-LD.
import Base from './Base.astro';
import { pathFor, ui } from '../i18n/ui';
import { appId, author, breadcrumbs, guidePath, guides, organization, siteUrl, type GuideFrontmatter } from '../lib/seo';

interface Props { frontmatter: GuideFrontmatter }
const f = Astro.props.frontmatter;
const t = ui[f.lang];
const path = guidePath(f.lang, f.slug);
const home = pathFor(f.lang, 'home');
const index = pathFor(f.lang, 'guides');
const locale = f.lang === 'vi' ? 'vi-VN' : 'en-US';
const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const related = guides(f.lang).filter((g) => g.slug !== f.slug);
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'TechArticle',
    headline: f.title, description: f.description, inLanguage: f.lang,
    datePublished: f.published, dateModified: f.updated,
    keywords: f.keywords.join(', '),
    image: `${siteUrl}/og/og-${f.lang}.png`,
    url: `${siteUrl}${path}`, mainEntityOfPage: `${siteUrl}${path}`,
    author, publisher: organization,
    about: { '@type': 'SoftwareApplication', '@id': appId, name: 'ShellX' },
  },
  breadcrumbs([
    { name: t.breadcrumbHome, path: home },
    { name: t.guidesHeading, path: index },
    { name: f.title, path },
  ]),
];
---
<Base lang={f.lang} page={null} paths={{ vi: guidePath('vi', f.slug), en: guidePath('en', f.slug) }}
      title={f.metaTitle} description={f.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={f.published} />
    <meta property="article:modified_time" content={f.updated} />
    <meta name="keywords" content={f.keywords.join(', ')} />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </Fragment>
  <div class="wrap guide">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={home}>{t.breadcrumbHome}</a><span aria-hidden="true">/</span>
      <a href={index}>{t.guidesHeading}</a>
    </nav>
    <article class="prose">
      <h1>{f.title}</h1>
      <p class="meta">
        {t.published} <time datetime={f.published}>{fmt(f.published)}</time>
        {f.updated !== f.published && <>{' · '}{t.lastUpdated} <time datetime={f.updated}>{fmt(f.updated)}</time></>}
        {' · '}<span>{author.name}</span>
      </p>
      <slot />
    </article>
    <aside class="cta">
      <h2>{t.guideCtaHeading}</h2>
      <p>{t.guideCtaBody}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={`${home}#download`}>{t.ctaFree}</a>
        <a class="btn btn-ghost" href={`${home}#how`}>{t.ctaHow}</a>
      </div>
    </aside>
    {related.length > 0 && (
      <nav class="related" aria-labelledby="related-h">
        <h2 id="related-h">{t.relatedGuides}</h2>
        <ul>
          {related.map((g) => <li><a href={g.path}>{g.title}</a><p>{g.description}</p></li>)}
        </ul>
      </nav>
    )}
  </div>
</Base>

<style>
  .guide { max-width: 48rem; padding-top: 2.5rem; }
  .crumbs { display: flex; gap: 0.5rem; font-size: 0.9rem; color: var(--muted); margin-bottom: 1.5rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--fg); }
  .prose { font-size: 1.05rem; line-height: 1.75; }
  .prose h1 { font-size: clamp(2rem, 5vw, 2.9rem); margin-bottom: 0.75rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin: 0 0 2rem; }
  .meta a { color: var(--muted); }
  .prose :global(h2) { font-size: 1.6rem; margin: 2.5rem 0 0.75rem; }
  .prose :global(h3) { font-size: 1.2rem; margin: 1.75rem 0 0.5rem; }
  .prose :global(p), .prose :global(li) { color: #d6d1e8; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
  .prose :global(li) { margin: 0.35rem 0; }
  .prose :global(strong) { color: var(--fg); }
  .prose :global(code) { background: var(--card-2); border: 1px solid var(--border); border-radius: 6px; padding: 0.1em 0.35em; }
  .prose :global(pre) { background: var(--card) !important; border: 1px solid var(--border); border-radius: 12px;
                        padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.9rem; }
  .prose :global(pre code) { background: none; border: 0; padding: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.95rem;
                          display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--border); padding: 0.6rem 0.75rem; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--card-2); color: var(--fg); }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: 0.75rem 1.1rem; border-left: 3px solid var(--purple);
                               background: rgba(124, 58, 237, 0.08); border-radius: 0 10px 10px 0; }
  .cta { margin-top: 3rem; padding: 2rem; border-radius: 22px; border: 1px solid var(--border); text-align: center;
         background: linear-gradient(180deg, rgba(124, 58, 237, 0.18), rgba(21, 16, 38, 0.6)); }
  .cta h2 { font-size: 1.6rem; }
  .cta p { color: var(--muted); margin: 0 0 1.25rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
  .related { margin-top: 3rem; }
  .related h2 { font-size: 1.35rem; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .related li { padding: 1rem 1.2rem; border-radius: 14px; background: var(--card); border: 1px solid var(--border); }
  .related li a { font-weight: 600; text-decoration: none; }
  .related li p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.92rem; }
</style>
