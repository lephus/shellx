<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (monochrome) icon: the foreground glyphs in solid white; the launcher tints them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="768"
    android:viewportHeight="768">
    <!-- The logo's 512 units fill the 72 dp the launcher shows, so the glyphs stay inside the safe circle. -->
    <group android:translateX="128" android:translateY="128">
        <!-- 4. "<", the phone side -->
        <path android:pathData="M384,122L290,234L384,346" android:strokeWidth="54" android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" android:strokeLineJoin="round" />
        <!-- 5. ">", the computer side and the prompt -->
        <path android:pathData="M128,122L222,234L128,346" android:strokeWidth="54" android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" android:strokeLineJoin="round" />
        <!-- 6. the cursor -->
        <path android:pathData="M308,398H376A8,8 0,0 1,384 406V416A8,8 0,0 1,376 424H308A8,8 0,0 1,300 416V406A8,8 0,0 1,308 398Z" android:fillColor="#FFFFFFFF" />
    </group>
</vector>
