// The ShellXTests bundle, on top of the project's Debug/Release.xcconfig: hosted in the app, with a
// generated Info.plist and no entitlements or asset catalog of its own.

PRODUCT_BUNDLE_IDENTIFIER = com.shellx.dev.tests
INFOPLIST_FILE =
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_PREPROCESS = NO
CODE_SIGN_ENTITLEMENTS =
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
SWIFT_EMIT_LOC_STRINGS = NO
TEST_HOST = $(BUILT_PRODUCTS_DIR)/ShellX.app/ShellX
BUNDLE_LOADER = $(TEST_HOST)
