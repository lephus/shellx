// Release: the App Store build "ShellX".

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.shellx.prod
SHELLX_DISPLAY_NAME = ShellX
SHELLX_APS_ENVIRONMENT = production
// Google sign-in: the iOS OAuth client of com.shellx.prod without its ".apps.googleusercontent.com" suffix.
// Not a secret. release/mobile/ios.sh refuses an App Store build that still has the placeholder.
SHELLX_GOOGLE_IOS_CLIENT = 0-shellx-placeholder

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
VALIDATE_PRODUCT = YES
MTL_ENABLE_DEBUG_INFO = NO

// ShellXAppTestSupport (FakeRelayAccount, FakeIdentityProvider, InMemorySecretStore and the other test fakes) serves
// tests and previews only; the in-app demo is ShellXDemo, which ships. Xcode links a package product in
// every configuration and dead-stripping keeps its Swift type metadata, so it is left out of the
// link here. The exclusion matches by file name (the product links as ShellXAppTestSupport.o): a
// renamed product would slip back in, which `dev.sh test release` and ios.sh then refuse.
EXCLUDED_SOURCE_FILE_NAMES = ShellXAppTestSupport*
