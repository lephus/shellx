// Release: the App Store build "ShellX".

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.shellx.prod
SHELLX_DISPLAY_NAME = ShellX

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
VALIDATE_PRODUCT = YES
MTL_ENABLE_DEBUG_INFO = NO

// ShellXAppTestSupport (FakeMac, FakeRelayAccount) serves the Debug demo only, and every use of it
// is under #if DEBUG. Xcode links a package product in every configuration and dead-stripping keeps
// its Swift type metadata, so it is left out of the link here: the App Store build never contains it.
EXCLUDED_SOURCE_FILE_NAMES = ShellXAppTestSupport*
