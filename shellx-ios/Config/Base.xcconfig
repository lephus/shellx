// Build settings shared by every configuration of ShellX.xcodeproj. Debug.xcconfig and
// Release.xcconfig include this file and are the project's configuration files;
// ShellXTests.xcconfig adjusts the test bundle on top of them.

#include "Version.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
IPHONEOS_DEPLOYMENT_TARGET = 17.0
// iPhone only.
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

DEVELOPMENT_TEAM = W4RF3W4VTZ
CODE_SIGN_STYLE = Automatic

INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO
// Info.plist goes through the C preprocessor (`cc -E -P -x c`), so a configuration can add keys only
// it needs with `#if` (Debug.xcconfig). Keep the plist free of a bare `'` and of `//` outside quotes:
// C would read them as a character literal or a comment.
INFOPLIST_PREPROCESS = YES
CODE_SIGN_ENTITLEMENTS = Config/ShellX.entitlements

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

ALWAYS_SEARCH_USER_PATHS = NO
COPY_PHASE_STRIP = NO
CLANG_ENABLE_MODULES = YES
DEAD_CODE_STRIPPING = YES
ENABLE_PREVIEWS = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
