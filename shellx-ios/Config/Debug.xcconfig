// Debug: "ShellX Dev". One app id everywhere (com.shellx.prod): on a phone it replaces the App Store /
// TestFlight build "ShellX" and shares its Keychain items.

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.shellx.prod
SHELLX_DISPLAY_NAME = ShellX Dev
// Push from paired Macs: Debug builds talk to the APNs sandbox (the relay sends their tokens there).
SHELLX_APS_ENVIRONMENT = development
// Google sign-in: the one iOS OAuth client of com.shellx.prod (Debug and Release use the same one) without
// its ".apps.googleusercontent.com" suffix (Info.plist ShellXGoogleClientID). Not a secret. Until that client
// exists, the placeholder makes Continue with Google report "not available in this build".
SHELLX_GOOGLE_IOS_CLIENT = 852509094750-2u1non5qq4qgpg0i1ko9u2hkdicqkbfj
// App Transport Security's local-network exception, for a relay on the Mac over plain HTTP
// (SHELLX_API_BASE, honoured by Debug builds only). Release never has it: ios.sh --check-app refuses it.
INFOPLIST_PREPROCESSOR_DEFINITIONS = SHELLX_ALLOWS_LOCAL_NETWORKING=1

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
ENABLE_TESTABILITY = YES
ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
