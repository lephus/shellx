{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Why the app asks for the camera (system prompt).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX uses the camera to scan the pairing QR code on your Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX dùng camera để quét mã QR ghép cặp trên Mac."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Why the app asks for the microphone (system prompt).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX listens while you hold the mic button to talk to your agents."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX nghe khi bạn giữ nút mic để nói với agent."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Why the app asks for speech recognition (system prompt).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple turns your speech into text to send to your agents."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple chuyển giọng nói của bạn thành chữ để gửi cho agent."
          }
        }
      }
    }
  },
  "version": "1.0"
}
