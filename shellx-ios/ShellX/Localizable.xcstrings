    "composer.attach": {
      "comment": "VoiceOver label of the composer's + button, which opens Photos and Files.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach"
          }
        },
