    "settings.account.signOut": {
      "comment": "Destructive button that signs out, also the title of its confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất"
          }
        }
      }
    },
    "settings.account.signOut.confirm": {
      "comment": "Message of the sign-out confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone will be removed from every paired Mac, and its history will be deleted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này sẽ bị gỡ khỏi mọi Mac đã ghép cặp, và lịch sử trên iPhone sẽ bị xoá."
          }
        }
      }
    },
    "settings.account.title": {
      "comment": "Settings section header.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản"
          }
        }
      }
    },
    "settings.title": {
      "comment": "Title of the Settings screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt"
          }
        }
      }
    },
    "signin.button": {
      "comment": "Primary button of the sign-in screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập"
          }
        }
      }
    },
    "signin.email": {
      "comment": "Label of the email field, also the email row in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "signin.error.invalidCredentials": {
      "comment": "Sign-in error: credentials refused.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong email or password."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email hoặc mật khẩu không đúng."
          }
        }
      }
    },
    "signin.error.network": {
      "comment": "Sign-in error: no connection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach ShellX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được tới ShellX."
          }
        }
      }
    },
    "signin.error.rateLimited": {
      "comment": "Sign-in error: too many attempts.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a few minutes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại sau ít phút."
          }
        }
      }
    },
    "signin.error.server": {
      "comment": "Sign-in error: unexpected server or storage error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX is having a problem. Try again later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ShellX đang gặp sự cố. Thử lại sau."
          }
        }
      }
    },
    "signin.expired": {
      "comment": "Shown on the sign-in screen after the relay refused the stored session.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired. Sign in again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Đăng nhập lại."
          }
        }
      }
    },
    "signin.password": {
      "comment": "Label of the password field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu"
          }
        }
      }
    },
    "signin.subtitle": {
      "comment": "Explains which account to use on the sign-in screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the ShellX account you signed in with on your Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tài khoản ShellX bạn đã đăng nhập trên Mac."
          }
        }
      }
    },
    "signin.title": {
      "comment": "Heading of the sign-in screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to ShellX"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập ShellX"
          }
        }
      }
    }
