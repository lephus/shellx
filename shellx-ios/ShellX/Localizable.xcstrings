    "settings.voice.server %@": {
      "comment": "Settings › Voice: speech goes to Apple's servers (the spoken language's name).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can't recognize %@ on device, so your voice goes to Apple's servers for recognition. ShellX never receives your voice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này chưa nhận dạng được %@ ngay trên máy, nên giọng nói được gửi tới máy chủ của Apple để nhận dạng. ShellX không nhận giọng nói của bạn."
          }
        }
      }
    },
