{
  "sourceLanguage": "en",
  "strings": {
    "agent.busy": {
      "comment": "The agent did not take the message because it is busy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent is busy; try again later"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent đang bận, thử lại sau"
          }
        }
      }
    },
    "agent.close": {
      "comment": "Swipe action on an agent's card, and the confirm button: close the agent's terminal tab on the Mac.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng"
          }
        }
      }
    },
    "agent.close.confirm": {
      "comment": "Message of the confirmation before closing an agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its terminal tab on the Mac will be closed. If it is the workspace's last tab, the workspace closes too."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab terminal của agent trên Mac sẽ bị đóng. Nếu đó là tab cuối của workspace, workspace cũng đóng theo."
          }
        }
      }
    },
    "agent.close.menu": {
      "comment": "Item of the ••• menu on an agent screen (shown red): close the agent's terminal tab on the Mac; it asks to confirm first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close Agent…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng agent…"
          }
        }
      }
    },
    "agent.close.title %@": {
      "comment": "Title of the confirmation before closing an agent; the argument is the agent's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng agent %@?"
          }
        }
      }
    },
    "agent.cut": {
      "comment": "Under a chat entry the Mac cut short.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… (cut; see it in full on the Mac)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "… (đã cắt, xem đầy đủ trên Mac)"
          }
        }
      }
    },
    "agent.empty": {
      "comment": "An agent's chat with no messages yet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages yet. New ones show up here as the agent writes them."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tin nhắn nào. Tin mới sẽ hiện ở đây khi agent viết."
          }
        }
      }
    },
    "agent.empty.failed": {
      "comment": "An agent's chat whose first messages could not be loaded; a Try again button follows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the messages."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được tin nhắn."
          }
        }
      }
    },
    "agent.empty.offline %@": {
      "comment": "An agent's chat with no copy on the phone while its Mac is offline. The argument is the Mac's name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is offline. Messages show up here when it's back."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang offline. Tin nhắn sẽ hiện ở đây khi Mac kết nối lại."
          }
        }
      }
    },
    "agent.forceStop": {
      "comment": "Confirm button of Force Stop.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Stop"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng hẳn"
          }
        }
      }
    },
    "agent.forceStop.menu": {
      "comment": "Menu item under Stop: a stronger stop, asks to confirm first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Stop…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng hẳn…"
          }
        }
      }
    },
    "agent.forceStop.message": {
      "comment": "Message of the Force Stop confirmation.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends Ctrl+C to the agent. Use it when Stop doesn't work."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh này gửi Ctrl+C tới agent. Dùng khi Dừng không có tác dụng."
          }
        }
      }
    },
    "agent.forceStop.title %@ %@": {
      "comment": "Title of the Force Stop confirmation. 1: agent name, 2: workspace.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force stop %1$@ in %2$@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng hẳn %1$@ ở %2$@?"
          }
        }
      }
    },
    "agent.gone": {
      "comment": "The Mac no longer has this agent session.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is gone from the Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên này không còn trên Mac"
          }
        }
      }
    },
    "agent.menu": {
      "comment": "The ••• button on an agent screen: spoken label (VoiceOver); it opens Close Agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent actions"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác vụ agent"
          }
        }
      }
    },
    "agent.newMessages": {
      "comment": "Button over the bottom of an agent's chat: newer messages came while the user read older ones.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin mới"
          }
        }
      }
    },
    "agent.newMessages.hint": {
      "comment": "VoiceOver hint of the New messages button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolls to the newest message"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn tới tin mới nhất"
          }
        }
      }
    },
    "agent.older.failed": {
      "comment": "At the top of an agent's chat when older messages could not be loaded; a Try again button follows.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load older messages."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được tin cũ hơn."
          }
        }
      }
    },
    "agent.olderOnMac": {
      "comment": "At the top of an agent's chat when the phone keeps no older messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older messages are only on the Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin cũ hơn chỉ còn trên Mac."
          }
        }
      }
    },
    "agent.open.hint": {
      "comment": "VoiceOver hint of an agent chip or a done note: activating it opens that agent's chat.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the agent's chat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cuộc trò chuyện với agent"
          }
        }
      }
    },
    "agent.sent": {
      "comment": "Shown after the agent took a message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi"
          }
        }
      }
    },
    "agent.state.done": {
      "comment": "An agent session finished its turn (idle).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        }
      }
    },
    "agent.state.ended": {
      "comment": "An agent session has ended.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ended"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết thúc"
          }
        }
      }
    },
    "agent.state.error": {
      "comment": "A workspace's agent failed (state label on its row).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi"
          }
        }
      }
    },
    "agent.state.needsYou": {
      "comment": "An agent session waits for the user.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs you"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bạn"
          }
        }
      }
    },
    "agent.state.offline": {
      "comment": "An agent session whose Mac is not online (its last known state is not shown).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac offline"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac đang offline"
          }
        }
      }
    },
    "agent.state.running": {
      "comment": "An agent session is working (since when is not known).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chạy"
          }
        }
      }
    },
    "agent.state.running %@": {
      "comment": "An agent session is working; the argument is how long (\"4 minutes\").",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running for %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chạy %@"
          }
        }
      }
    },
    "agent.stop": {
      "comment": "The agent screen's Stop button: interrupts the agent's current turn.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng"
          }
        }
      }
    },
    "agent.stop.failed": {
      "comment": "Shown when the Mac could not stop the agent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac couldn't stop the agent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac không dừng được agent"
          }
        }
      }
    },
    "agent.stop.noAnswer": {
      "comment": "Shown when the Mac did not answer a Stop or Force Stop.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac didn't answer. The agent may still be running."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac không trả lời. Agent có thể vẫn đang chạy."
          }
        }
      }
    },
    "agent.stop.sent": {
      "comment": "Shown after the Mac took a Stop or Force Stop.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi lệnh dừng"
          }
        }
      }
    },
    "agent.thought": {
      "comment": "Label of the agent's collapsed reasoning; tapping it shows the text.",
