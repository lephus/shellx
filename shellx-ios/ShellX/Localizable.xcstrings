    "workspaces.alert.refused.closeAgent": {
      "comment": "Alert: the Mac refused to close an agent's terminal tab, because it blocks remote control, because the tab is pinned, or because the tab is the last one of a workspace that is pinned, is the last in its window, or is set to stay open when its last tab closes.",
