          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy nghĩ"
          }
        }
      }
    },
    "agent.tool.expandHint": {
