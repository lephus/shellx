 fn hex32(h: &str) -> [u8; 32] {
     let mut out = [0u8; 32];
     for (i, b) in out.iter_mut().enumerate() {
         *b = u8::from_str_radix(&h[2 * i..2 * i + 2], 16).unwrap();
     }
     out
 }

