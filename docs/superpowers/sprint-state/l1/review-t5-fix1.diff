+import ShellXBrand
 
 extension AppDelegate {
     @MainActor
     func handleCloudTeamPickerShortcut(_ event: NSEvent) -> Bool {
+        // ShellX: teams are a Manaflow Cloud service; the key passes through
+        // and no "Cloud unavailable" alert appears.
+        guard ShellXFeatures.cloud else { return false }
         guard matchConfiguredShortcut(event: event, action: .openTeamPicker) else { return false }
         _ = openCloudTeamPicker(
             preferredWindow: event.window ?? shortcutRoutingActiveWindow,
             debugSource: "shortcut.openTeamPicker"
         )
         return true
     }
 
     /// Reveals the active window's Cloud panel and requests its team menu.
     @MainActor
     @discardableResult
     func openCloudTeamPicker(
         preferredWindow: NSWindow? = nil,
         debugSource: String
     ) -> Bool {
+        guard ShellXFeatures.cloud else { return false }
         guard CloudMachinesFeature.isEnabled,
               RightSidebarMode.machines.isAvailable() else {
             let alert = NSAlert()
             alert.messageText = String(localized: "command.auth.teamPicker.title", defaultValue: "Open Team Picker")
             alert.informativeText = CloudMachinesFeature.disabledMessage
             alert.alertStyle = .informational
             alert.addButton(withTitle: String(localized: "common.ok", defaultValue: "OK"))
             if let window = preferredWindow ?? NSApp.keyWindow ?? NSApp.mainWindow {
                 alert.beginSheetModal(for: window)
             } else {
diff --git a/Sources/ShellX/ShellXSwitches.swift b/Sources/ShellX/ShellXSwitches.swift
new file mode 100644
index 0000000000..b0c2c197e4
--- /dev/null
+++ b/Sources/ShellX/ShellXSwitches.swift
@@ -0,0 +1,14 @@
+import ShellXBrand
+
+/// App-side mirror of ``ShellXFeatures`` for code that cannot import
+/// ShellXBrand, chiefly the app-hosted test bundle: upstream tests of logic
+/// parked behind a switch use `.enabled(if: ShellXSwitches.remoteMachines)` so
+/// they come back on their own when Wave 2 flips it.
+enum ShellXSwitches {
+    /// Manaflow Cloud (sign-in, accounts, Cloud machines, billing, Pro). Off for good.
+    static let cloud = ShellXFeatures.cloud
+    /// CodeRouter. Off for good.
+    static let codeRouter = ShellXFeatures.codeRouter
+    /// ShellX's own remote machines and device mirroring (Wave 2).
+    static let remoteMachines = ShellXFeatures.remoteMachines
+}
